# Copy to .env and adjust if needed:
#   cp .env.example .env

# Optional: named AWS profile from ~/.aws/credentials
# Leave empty to use default credential chain / env vars
AWS_PROFILE=

AWS_REGION=

# SSM bastion + remote targets
BASTION_ID=
RDS_HOST=
MSK_B1_HOST=
MSK_B2_HOST=

# RDS credentials (Secrets Manager)
DB_SECRET_ID=

# pgAdmin web login (local UI only — not the RDS password)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
